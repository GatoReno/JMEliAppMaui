<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JMEliAppMaui.ViewModels"
             xmlns:models="clr-namespace:JMEliAppMaui.Models"
             x:DataType="vm:ClientDetailsViewModel"
             x:Class="JMEliAppMaui.Views.ClientDetailsPage"
             Title="Detalle del Cliente">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Frame Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#4a148c, Dark=#2d1b69}"
               CornerRadius="0" Padding="20" HasShadow="False">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Frame Grid.Column="0" CornerRadius="30" WidthRequest="60" HeightRequest="60"
                       Padding="0" HasShadow="False" IsClippedToBounds="True"
                       BackgroundColor="#6a1b9a">
                    <Image Source="{Binding Client.UrlImage}" Aspect="AspectFill"
                           WidthRequest="60" HeightRequest="60"/>
                </Frame>
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Client.FullName}" TextColor="White" 
                           FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{Binding Client.Email}" TextColor="#ce93d8" FontSize="12"/>
                    <Label Text="{Binding Client.Phone}" TextColor="#e1bee7" FontSize="11"/>
                </StackLayout>
                <Button Grid.Column="2" Text="📷" BackgroundColor="Transparent"
                        TextColor="White" FontSize="18"
                        Command="{Binding UpdateUserImageCommand}"/>
            </Grid>
        </Frame>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="16" Spacing="12">

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="✏️ Editar" FontSize="12"
                            BackgroundColor="{AppThemeBinding Light=#ede7f6, Dark=#3d2d5c}"
                            TextColor="{AppThemeBinding Light=#4a148c, Dark=White}"
                            CornerRadius="8"
                            Command="{Binding EditCommand}"/>
                    <Button Grid.Column="1" Text="📋 Contratos" FontSize="12"
                            BackgroundColor="{AppThemeBinding Light=#e3f2fd, Dark=#1a3a5c}"
                            TextColor="{AppThemeBinding Light=#1565c0, Dark=White}"
                            CornerRadius="8"
                            Command="{Binding ContractCommand}"/>
                    <Button Grid.Column="2" Text="📝 Generar" FontSize="12"
                            BackgroundColor="{AppThemeBinding Light=#e8f5e9, Dark=#1b4332}"
                            TextColor="{AppThemeBinding Light=#2e7d32, Dark=White}"
                            CornerRadius="8"
                            Command="{Binding GenerateContractCommand}"/>
                </Grid>

                <!-- Client info (edit mode) -->
                <Frame IsVisible="{Binding IsEdit}" Padding="14" CornerRadius="10"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}">
                    <StackLayout Spacing="8">
                        <Label Text="Datos del Cliente" FontAttributes="Bold" FontSize="14"
                               TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
                        <Entry Placeholder="Nombre completo" Text="{Binding Client.FullName}"/>
                        <Entry Placeholder="Email" Text="{Binding Client.Email}" Keyboard="Email"/>
                        <Entry Placeholder="Teléfono" Text="{Binding Client.Phone}" Keyboard="Telephone"/>
                        <Entry Placeholder="Ocupación" Text="{Binding Client.Occupation}"/>
                        <Entry Placeholder="Escolaridad" Text="{Binding Client.Scholarship}"/>
                        <Entry Placeholder="Trabajo" Text="{Binding Client.Work}"/>
                        <Entry Placeholder="Oficina" Text="{Binding Client.Office}"/>
                        <Entry Placeholder="Parentesco" Text="{Binding Client.Relationship}"/>
                        <Entry Placeholder="Dirección" Text="{Binding Client.Address}"/>
                        <Button Text="💾 Guardar Cambios" BackgroundColor="#4a148c" TextColor="White"
                                CornerRadius="8" Command="{Binding EditCommand}"/>
                    </StackLayout>
                </Frame>

                <!-- Students list -->
                <Frame Padding="14" CornerRadius="10" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}"
                       IsVisible="{Binding IsEditVisible}">
                    <StackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="🎒 Alumnos" FontAttributes="Bold" FontSize="14"
                                   TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
                            <Button Grid.Column="1" Text="+ Inscribir" FontSize="11"
                                    BackgroundColor="#4a148c" TextColor="White"
                                    CornerRadius="14" Padding="10,4"
                                    Command="{Binding AddStudentCommand}"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding StudentList}" 
                                        HeightRequest="200"
                                        x:Name="StudentListView">
                            <CollectionView.EmptyView>
                                <Label Text="Sin alumnos registrados" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#999, Dark=#666}"
                                       HorizontalOptions="Center" Margin="0,20"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:StudentModel">
                                    <Frame Margin="0,3" Padding="10" CornerRadius="8" HasShadow="False"
                                           BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1e1e2e}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold"/>
                                                <Label FontSize="11" TextColor="{AppThemeBinding Light=#666, Dark=#aaa}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Level}"/>
                                                            <Span Text=" · "/>
                                                            <Span Text="{Binding Grade}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </StackLayout>
                                            <Label Grid.Column="1" Text="→" FontSize="16"
                                                   TextColor="#4a148c" VerticalOptions="Center"/>
                                        </Grid>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                Command="{Binding Source={x:Reference StudentListView}, Path=BindingContext.StudentDetailsCommand}"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Contracts list -->
                <Frame Padding="14" CornerRadius="10" IsVisible="{Binding IsContract}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}">
                    <StackLayout Spacing="8">
                        <Label Text="📋 Contratos" FontAttributes="Bold" FontSize="14"
                               TextColor="{AppThemeBinding Light=#1565c0, Dark=#90caf9}"/>
                        <CollectionView ItemsSource="{Binding Contracts}" 
                                        HeightRequest="200"
                                        x:Name="ContractsListView">
                            <CollectionView.EmptyView>
                                <Label Text="Sin contratos" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#999, Dark=#666}"
                                       HorizontalOptions="Center" Margin="0,20"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ContractModel">
                                    <Frame Margin="0,3" Padding="10" CornerRadius="8" HasShadow="False"
                                           BackgroundColor="{AppThemeBinding Light=#e3f2fd, Dark=#1a3a5c}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1565c0, Dark=White}"/>
                                                <Label Text="{Binding Type}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
                                            </StackLayout>
                                            <Label Grid.Column="1" Text="📄" FontSize="18" VerticalOptions="Center"/>
                                        </Grid>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                Command="{Binding Source={x:Reference ContractsListView}, Path=BindingContext.DetailsContractCommand}"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Loading -->
                <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                                   Color="#4a148c" HorizontalOptions="Center"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
