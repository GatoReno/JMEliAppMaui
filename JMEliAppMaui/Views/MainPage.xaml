<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JMEliAppMaui.MainPage"
             Title="Inicio"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a2e}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <StackLayout Spacing="4" Margin="0,10,0,20">
                <Label Text="🏫 Joan Miró" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
                <Label Text="Panel de Administración Escolar" 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
            </StackLayout>

            <!-- Quick Actions Grid -->
            <Label Text="Accesos Rápidos" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"
                   Margin="0,0,0,8"/>

            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="Auto,Auto,Auto,Auto" 
                  ColumnSpacing="12" 
                  RowSpacing="12">

                <!-- Row 0 -->
                <Frame Grid.Row="0" Grid.Column="0" 
                       BackgroundColor="{AppThemeBinding Light=#7b1fa2, Dark=#4a148c}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="👥" FontSize="28"/>
                        <Label Text="Clientes" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Tutores y familias" TextColor="#e1bee7" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClientsClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" 
                       BackgroundColor="{AppThemeBinding Light=#1565c0, Dark=#0d47a1}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="📚" FontSize="28"/>
                        <Label Text="Niveles" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Niveles y grados" TextColor="#bbdefb" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLevelsClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Row 1 -->
                <Frame Grid.Row="1" Grid.Column="0" 
                       BackgroundColor="{AppThemeBinding Light=#2e7d32, Dark=#1b5e20}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="📅" FontSize="28"/>
                        <Label Text="Ciclos" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Ciclos escolares" TextColor="#c8e6c9" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCyclesClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" 
                       BackgroundColor="{AppThemeBinding Light=#e65100, Dark=#bf360c}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="📋" FontSize="28"/>
                        <Label Text="Contratos" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Tipos de contrato" TextColor="#ffe0b2" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContractsClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Row 2 -->
                <Frame Grid.Row="2" Grid.Column="0" 
                       BackgroundColor="{AppThemeBinding Light=#1565c0, Dark=#0d47a1}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="🛡️" FontSize="28"/>
                        <Label Text="Autorizados" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Personas para recoger" TextColor="#bbdefb" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAuthorizedClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="1" 
                       BackgroundColor="{AppThemeBinding Light=#4a148c, Dark=#311b92}" 
                       CornerRadius="12" Padding="16" HasShadow="True">
                    <StackLayout Spacing="8">
                        <Label Text="📅" FontSize="28"/>
                        <Label Text="Ciclo Activo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Ver alumnos del ciclo" TextColor="#ce93d8" FontSize="11"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCycleDashboardClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Row 3 - Full width logout -->
                <Frame Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#2d2d44}" 
                       CornerRadius="12" Padding="12" HasShadow="False"
                       BorderColor="{AppThemeBinding Light=#e0e0e0, Dark=#444}">
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10">
                        <Label Text="🚪" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Cerrar Sesión" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#c62828, Dark=#ef5350}"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                    </Frame.GestureRecognizers>
                </Frame>
            </Grid>

        </StackLayout>
    </ScrollView>
</ContentPage>

