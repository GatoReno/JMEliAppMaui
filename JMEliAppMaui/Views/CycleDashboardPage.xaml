<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JMEliAppMaui.ViewModels"
             x:DataType="vm:CycleDashboardViewModel"
             x:Class="JMEliAppMaui.Views.CycleDashboardPage"
             Title="Ciclo Escolar">

    <Grid>
        <!-- STATE: Loading -->
        <ActivityIndicator IsVisible="{Binding IsLoading}" 
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Color="#4a148c"/>

        <!-- STATE: No Cycle - Guide to create one -->
        <StackLayout IsVisible="{Binding ShowNoCycle}" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Padding="40" Spacing="20">
            <Label Text="📅" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="¡Bienvenido!" 
                   FontSize="24" FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
            <Label Text="Para comenzar, necesitas crear tu primer ciclo escolar. El ciclo define el período (ej: Agosto 2026 - Julio 2027) en el que inscribirás alumnos." 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
            <Button Text="Crear Ciclo Escolar"
                    BackgroundColor="#4a148c"
                    TextColor="White"
                    CornerRadius="24"
                    Padding="24,12"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Command="{Binding CreateCycleCommand}"/>
        </StackLayout>

        <!-- STATE: No Clients - Guide to add a tutor -->
        <StackLayout IsVisible="{Binding ShowNoClients}" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Padding="40" Spacing="20">
            <Label Text="👥" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="Ciclo creado ✓" 
                   FontSize="14" 
                   TextColor="#2e7d32" 
                   HorizontalOptions="Center"/>
            <Label Text="Ahora agrega un cliente" 
                   FontSize="24" FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
            <Label Text="Los clientes son los tutores (papás, mamás) responsables de los alumnos. Primero registras al tutor, luego inscribes a sus hijos." 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
            <Button Text="Agregar Cliente (Tutor)"
                    BackgroundColor="#1565c0"
                    TextColor="White"
                    CornerRadius="24"
                    Padding="24,12"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Command="{Binding AddClientCommand}"/>
        </StackLayout>

        <!-- STATE: No Students - Guide to enroll -->
        <StackLayout IsVisible="{Binding ShowNoStudents}" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Padding="40" Spacing="20">
            <Label Text="🎒" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="Ciclo ✓  Cliente ✓" 
                   FontSize="14" 
                   TextColor="#2e7d32" 
                   HorizontalOptions="Center"/>
            <Label Text="Inscribe a tu primer alumno" 
                   FontSize="24" FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
            <Label Text="Ve al detalle de un cliente y agrega a su hijo como alumno. Se vinculará automáticamente al ciclo activo." 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
            <Button Text="Ir a Clientes para Inscribir"
                    BackgroundColor="#2e7d32"
                    TextColor="White"
                    CornerRadius="24"
                    Padding="24,12"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Command="{Binding AddStudentCommand}"/>
        </StackLayout>

        <!-- STATE: Ready - Full Dashboard -->
        <Grid IsVisible="{Binding ShowReady}" RowDefinitions="Auto,Auto,*" RowSpacing="0">

            <!-- Cycle Header -->
            <Frame Grid.Row="0" 
                   BackgroundColor="{AppThemeBinding Light=#4a148c, Dark=#2d1b69}"
                   CornerRadius="0" Padding="20" HasShadow="False">
                <StackLayout Spacing="8">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="📅" FontSize="24" VerticalOptions="Center"/>
                        <StackLayout>
                            <Label Text="{Binding ActiveCycleName}" 
                                   TextColor="White" FontSize="20" FontAttributes="Bold"/>
                            <Label Text="{Binding CyclePeriod}" 
                                   TextColor="#ce93d8" FontSize="12"/>
                        </StackLayout>
                        <Button Text="⚙️" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="18"
                                HorizontalOptions="EndAndExpand"
                                Command="{Binding ManageCyclesCommand}"/>
                    </StackLayout>

                    <!-- Stats Row -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,10,0,0">
                        <Frame Grid.Column="0" BackgroundColor="#6a1b9a" CornerRadius="8" Padding="8" HasShadow="False">
                            <StackLayout HorizontalOptions="Center">
                                <Label Text="{Binding TotalStudents}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Alumnos" TextColor="#e1bee7" FontSize="10" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                        <Frame Grid.Column="1" BackgroundColor="#2e7d32" CornerRadius="8" Padding="8" HasShadow="False">
                            <StackLayout HorizontalOptions="Center">
                                <Label Text="{Binding ActiveCount}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Activos" TextColor="#c8e6c9" FontSize="10" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                        <Frame Grid.Column="2" BackgroundColor="#f9a825" CornerRadius="8" Padding="8" HasShadow="False">
                            <StackLayout HorizontalOptions="Center">
                                <Label Text="{Binding AdeudoCount}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Adeudo" TextColor="#fff9c4" FontSize="10" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Status Filter Tabs -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e2e}"
                        Padding="12,8">
                <StackLayout Orientation="Horizontal" Spacing="8">
                    <Button Text="Todos" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding AllFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Todos"/>
                    <Button Text="Inscrito" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding InscritoFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Inscrito"/>
                    <Button Text="Activo" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding ActivoFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Activo"/>
                    <Button Text="Adeudo" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding AdeudoFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Adeudo"/>
                    <Button Text="Baja" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding BajaFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Baja"/>
                    <Button Text="Suspendido" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding SuspendidoFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Suspendido"/>
                    <Button Text="Egresado" FontSize="12" Padding="12,6" CornerRadius="16"
                            BackgroundColor="{Binding EgresadoFilterColor}" TextColor="White"
                            Command="{Binding FilterCommand}" CommandParameter="Egresado"/>
                </StackLayout>
            </ScrollView>

            <!-- Student List -->
            <RefreshView Grid.Row="2" 
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding FilteredEnrollments}"
                                x:Name="EnrollmentList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EnrollmentDisplayItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem Text="Ver"
                                               BackgroundColor="#4a148c"
                                               Command="{Binding Source={x:Reference EnrollmentList}, Path=BindingContext.ViewStudentCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Estado"
                                               BackgroundColor="#e65100"
                                               Command="{Binding Source={x:Reference EnrollmentList}, Path=BindingContext.ChangeStatusCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeView.RightItems>

                                <Frame Margin="12,4" Padding="12" CornerRadius="10" HasShadow="True"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                            Command="{Binding Source={x:Reference EnrollmentList}, Path=BindingContext.ViewStudentCommand}"/>
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Status bar -->
                                        <BoxView Grid.Column="0" 
                                                 WidthRequest="4" CornerRadius="2"
                                                 Color="{Binding StatusColor}"
                                                 VerticalOptions="Fill"/>
                                        <!-- Info -->
                                        <StackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding StudentName}" 
                                                   FontSize="15" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                                            <Label FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#aaa}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Level}"/>
                                                        <Span Text=" · "/>
                                                        <Span Text="{Binding Grade}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding ClientName}" 
                                                   FontSize="11" 
                                                   TextColor="{AppThemeBinding Light=#999, Dark=#777}"/>
                                        </StackLayout>
                                        <!-- Badge -->
                                        <Frame Grid.Column="2" 
                                               BackgroundColor="{Binding StatusColor}" 
                                               CornerRadius="12" Padding="8,4"
                                               HasShadow="False" VerticalOptions="Center">
                                            <Label Text="{Binding Status}" 
                                                   TextColor="White" FontSize="10" FontAttributes="Bold"/>
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
