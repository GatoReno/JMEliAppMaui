<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JMEliAppMaui.ViewModels"
             xmlns:models="clr-namespace:JMEliAppMaui.Models"
             x:DataType="vm:ClientsViewModel"
             x:Class="JMEliAppMaui.Views.ClientsPage"
             Title="Clientes (Tutores)">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="0"
                           IsVisible="{Binding IsLoading}" 
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           Margin="0,10"
                           Color="#4a148c"/>

        <!-- Search bar + Add button -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*,Auto" 
              Padding="14,8"
              IsVisible="{Binding IsSearch}">
            <SearchBar Grid.Column="0" 
                       Placeholder="Buscar por nombre o email..."
                       Text="{Binding SearchText}"
                       HorizontalOptions="Fill"/>
            <Button Grid.Column="1" 
                    Text="+"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#4a148c"
                    CornerRadius="20"
                    WidthRequest="40" HeightRequest="40"
                    Command="{Binding AddCommand}"/>
        </Grid>

        <!-- Client List (NOT inside ScrollView — CollectionView handles its own scrolling) -->
        <CollectionView Grid.Row="2"
                        x:Name="ClientsCollectionView"
                        ItemsSource="{Binding ClientList}"
                        IsVisible="{Binding IsSearch}">

            <CollectionView.EmptyView>
                <StackLayout Padding="40" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="👥" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No hay clientes registrados" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#999, Dark=#666}"
                           FontSize="14"/>
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ClientModel">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItem Text="Ver"
                                       BackgroundColor="#4a148c"
                                       CommandParameter="{Binding .}"
                                       Command="{Binding Source={x:Reference ClientsCollectionView}, 
                                                         Path=BindingContext.DetailsClientCommand}"/>
                        </SwipeView.RightItems>

                        <Frame Margin="8,4" Padding="12" CornerRadius="10" HasShadow="True"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                    Command="{Binding Source={x:Reference ClientsCollectionView}, Path=BindingContext.DetailsClientCommand}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="{AppThemeBinding Light=#e8eaf6, Dark=#1a237e}"
                                       CornerRadius="20" WidthRequest="40" HeightRequest="40"
                                       Padding="0" HasShadow="False">
                                    <Label Text="👤" FontSize="18" 
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding FullName}" 
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                                    <Label Text="{Binding Email}" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
                                    <Label Text="{Binding Phone}" 
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#999, Dark=#777}"/>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Client Form (replaces list when visible) -->
        <ScrollView Grid.Row="2" IsVisible="{Binding OrPlus}">
            <StackLayout Padding="14" Spacing="8">
                <StackLayout Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Text="Nuevo Cliente" FontSize="18" FontAttributes="Bold" 
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
                    <Button Text="Cancelar"
                            BackgroundColor="{AppThemeBinding Light=#e0e0e0, Dark=#444}"
                            TextColor="{AppThemeBinding Light=#333, Dark=White}"
                            HorizontalOptions="EndAndExpand"
                            Command="{Binding AddBackCommand}"/>
                    <Button Text="Guardar"
                            BackgroundColor="#4a148c"
                            TextColor="White"
                            Command="{Binding AddCommand}"/>
                </StackLayout>

                <Entry Placeholder="Nombre completo *" Text="{Binding FullName}"/>
                <Entry Placeholder="Email *" Keyboard="Email" Text="{Binding Email}"/>
                <Entry Placeholder="Teléfono" Keyboard="Telephone" MaxLength="14" Text="{Binding Phone}"/>
                <Entry Placeholder="Ocupación" Text="{Binding Occupation}"/>
                <Entry Placeholder="Escolaridad" Text="{Binding Scholarship}"/>
                <Entry Placeholder="Lugar de trabajo" Text="{Binding Work}"/>
                <Entry Placeholder="Oficina" Text="{Binding Office}"/>
                <Entry Placeholder="Parentesco con el alumno" Text="{Binding Relationship}"/>
                <Entry Placeholder="Dirección" Text="{Binding Address}"/>
                <Entry Placeholder="INE (número de credencial)" Text="{Binding ClientINE}"/>
                <Entry Placeholder="CURP" Text="{Binding ClientCURP}"/>
                <Entry Placeholder="Teléfono de trabajo" Keyboard="Telephone" Text="{Binding ClientWorkPhone}"/>
                <Entry Placeholder="Teléfono de emergencia" Keyboard="Telephone" Text="{Binding ClientEmergencyPhone}"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
