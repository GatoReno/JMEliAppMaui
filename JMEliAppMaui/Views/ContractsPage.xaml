<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JMEliAppMaui.Views.ContractsPage"
             Title="Tipos de Contrato">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" 
              Padding="14" ColumnSpacing="8"
              BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1e1e2e}">
            <ActivityIndicator Grid.Column="0"
                               IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               Color="#4a148c"/>
            <Label Grid.Column="1" 
                   VerticalOptions="Center"
                   Text="Tipos de Contrato" 
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#4a148c, Dark=#ce93d8}"/>
            <Button Grid.Column="2"
                    Text="+"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#4a148c"
                    CornerRadius="20"
                    WidthRequest="40" HeightRequest="40"
                    Command="{Binding AddCommand}"/>
            <Button Grid.Column="3"
                    Text="←"
                    FontSize="18"
                    IsVisible="{Binding BackVisibility}"
                    TextColor="White"
                    BackgroundColor="#7b1fa2"
                    CornerRadius="20"
                    WidthRequest="40" HeightRequest="40"
                    Command="{Binding BackCommand}"/>
        </Grid>

        <!-- List -->
        <CollectionView Grid.Row="1"
                        x:Name="ContractListObservable"
                        ItemsSource="{Binding ContractList}"
                        IsVisible="{Binding IsShow}">
            <CollectionView.EmptyView>
                <StackLayout Padding="40" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="📋" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No hay tipos de contrato" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#999, Dark=#666}"/>
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItem Text="Detalles"
                                       BackgroundColor="#4a148c"
                                       CommandParameter="{Binding .}"
                                       Command="{Binding Source={x:Reference ContractListObservable}, 
                                                         Path=BindingContext.DetailsContractCommand}"/>
                        </SwipeView.RightItems>

                        <Frame Margin="8,4" Padding="14" CornerRadius="10" HasShadow="True"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d44}">
                            <Label Text="{Binding Name}" FontSize="15"
                                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add form -->
        <StackLayout Grid.Row="1" Padding="20" Spacing="12" IsVisible="{Binding IsAdd}">
            <Label Text="Nombre del tipo de contrato" FontSize="14"
                   TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"/>
            <Entry Text="{Binding ContractName}" Placeholder="Ej: Inscripción, Reinscripción"/>
            <Button Text="Agregar" 
                    BackgroundColor="#4a148c" 
                    TextColor="White" 
                    CornerRadius="8"
                    Command="{Binding AddCommand}"/>
        </StackLayout>
    </Grid>
</ContentPage>
