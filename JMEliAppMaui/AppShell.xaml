<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JMEliAppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JMEliAppMaui"
    xmlns:views="clr-namespace:JMEliAppMaui.Views" 
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="#4a148c"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.NavBarIsVisible="True"
    Title="Joan Miró - Admin">

    <Shell.FlyoutHeader>
        <StackLayout BackgroundColor="#4a148c" Padding="20">
            <Label Text="🏫 Joan Miró" 
                   TextColor="White" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Sistema de Gestión Escolar" 
                   TextColor="#ce93d8" 
                   FontSize="12" 
                   HorizontalOptions="Center"/>
        </StackLayout>
    </Shell.FlyoutHeader>

    <!-- Principal -->
    <FlyoutItem Title="📅 Ciclo Activo">
        <ShellContent Title="Ciclo"
                      ContentTemplate="{DataTemplate views:CycleDashboardPage}"
                      Route="CycleDashboardPage" />
    </FlyoutItem>

    <FlyoutItem Title="🏠 Inicio">
        <ShellContent Title="Inicio"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />
    </FlyoutItem>

    <!-- Gestión -->
    <FlyoutItem Title="👥 Clientes (Tutores)">
        <ShellContent Title="Clientes"
                  ContentTemplate="{DataTemplate views:ClientsPage}"
                  Route="ClientsPage" />
    </FlyoutItem>

    <FlyoutItem Title="🛡️ Autorizados para Recoger">
        <ShellContent Title="Autorizados"
                  ContentTemplate="{DataTemplate views:AuthorizedPickupPage}"
                  Route="AuthorizedPickupPage" />
    </FlyoutItem>

    <!-- Configuración Escolar -->
    <FlyoutItem Title="📚 Niveles y Grados">
        <ShellContent Title="Niveles"
                  ContentTemplate="{DataTemplate views:LevelsPage}"
                  Route="LevelsPage" />
    </FlyoutItem>

    <FlyoutItem Title="📅 Ciclos Escolares">
        <ShellContent Title="Ciclos"
                   ContentTemplate="{DataTemplate views:CyclesPage}"
                   Route="CyclesPage" />
    </FlyoutItem>

    <FlyoutItem Title="📋 Contratos">
        <ShellContent Title="Contratos"
                   ContentTemplate="{DataTemplate views:ContractsPage}"
                   Route="ContractsPage"/>
    </FlyoutItem>
</Shell>

